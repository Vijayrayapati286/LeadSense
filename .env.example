# Read by docker-compose.yml only, for the local Postgres container and to
# build the backend's DATABASE_URL inside the compose network. Copy to .env
# (gitignored) and fill in real values.
#
# App-level secrets/config (AWS, Groq, JWT secret, Azure AD, ...) are
# separate — see backend/.env.example.
POSTGRES_USER=bulkmailer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bulk_email_db
