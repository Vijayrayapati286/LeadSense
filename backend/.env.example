# Application
APP_NAME=Bulk Email Campaign Manager
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:8000

# Database (SQLite used as fallback when PostgreSQL unavailable).
# Under docker-compose this is overridden to point at the "db" service —
# see docker-compose.yml — so the localhost value below only matters when
# running the backend directly (outside a container).
DATABASE_URL=postgresql://bulkmailer:change-me@localhost:5432/bulk_email_db
USE_SQLITE_FALLBACK=true

# Microsoft Azure AD / Entra ID
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=noreply@yourcompany.com
# Dedicated SES-verified domain for the personalized From address (each
# rep's local part + this domain, e.g. jane.doe@mail.yourcompany.com) —
# kept separate from the org's real mail domain to protect its sender
# reputation/DMARC alignment. Leave unset to fall back to
# AWS_SES_SENDER_EMAIL's own domain.
AWS_SES_SENDING_DOMAIN=mail.yourcompany.com
USE_MOCK_SES=true
TEST_EMAIL_OVERRIDE=d.nikhileswar.reddy@gmail.com

# Groq
GROQ_API_KEY=your-groq-api-key
USE_MOCK_GROQ=true

# Blacklist / suppression
SOFT_BOUNCE_THRESHOLD=3

# Passwords for the named accounts in app/services/core_users.py — JSON
# object of {email: password}. Never commit real values; this file is a
# template only. Only emails present here (and in CORE_USERS) can log in.
CORE_USER_PASSWORDS={"name@feuji.com":"change-me"}

# LinkedIn Sales Navigator extraction (Apify + Playwright session check)
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Optional: dedicated actor for /in/ profile scrape (Profile Extractor).
# When empty, APIFY_ACTOR_ID is used as fallback.
APIFY_PROFILE_ACTOR_ID=
# Bulk Excel extract: concurrent Apify batches (reuses APIFY_ACTOR_ID / APIFY_PROFILE_ACTOR_ID)
MAX_CONCURRENT_APIFY_RUNS=10
APIFY_BATCH_SIZE=10
APIFY_MAX_RETRIES=5
MAX_BULK_URLS=250
BULK_RETRY_BASE_DELAY_SECONDS=5
BULK_RETRY_BACKOFF_MULTIPLIER=2
BULK_STALE_PROCESSING_SECONDS=900
# Comma-separated; matching last_error text is treated as non-retryable
BULK_NON_RETRYABLE_ERRORS=invalid url,malformed,permanently unavailable,profile not found,not a linkedin
LINKEDIN_LI_AT=
# Optional full cookie-array JSON from a "Copy Cookies" browser extension
# (server-side only; never sent by end users)
LINKEDIN_COOKIES_JSON=
# Profile extract-profile uses Playwright viewport screenshots + backend OCR
# (PaddleOCR if installed, else RapidOCR). Install: pip install rapidocr-onnxruntime paddleocr
