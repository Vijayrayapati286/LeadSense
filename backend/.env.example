# Application
APP_NAME=Bulk Email Campaign Manager
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:8000

# Database (SQLite used as fallback when PostgreSQL unavailable).
# Under docker-compose this is overridden to point at the "db" service —
# see docker-compose.yml — so the localhost value below only matters when
# running the backend directly (outside a container).
DATABASE_URL=postgresql://bulkmailer:change-me@localhost:5432/bulk_email_db
USE_SQLITE_FALLBACK=true

# Microsoft Azure AD / Entra ID
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# AWS SES
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_SES_SENDER_EMAIL=noreply@yourcompany.com
# Dedicated SES-verified domain for the personalized From address (each
# rep's local part + this domain, e.g. jane.doe@mail.yourcompany.com) —
# kept separate from the org's real mail domain to protect its sender
# reputation/DMARC alignment. Leave unset to fall back to
# AWS_SES_SENDER_EMAIL's own domain.
AWS_SES_SENDING_DOMAIN=mail.yourcompany.com

# ---------------------------------------------------------------------------
# LOCAL vs UAT — OOO / email delivery testing
#
# LOCAL (no real mail; flip status via simulate webhook):
#   USE_MOCK_SES=true
#   TEST_EMAIL_OVERRIDE=          (leave empty)
#   DEBUG=true
#   Then: POST /api/webhooks/simulate-event
#     {"email":"<recipient>","event_type":"out_of_office","campaign_id":<id>}
#
# UAT (real Outlook Automatic Replies → sender Reply-To inbox):
#   USE_MOCK_SES=false
#   TEST_EMAIL_OVERRIDE=          (MUST be empty or mail never reaches the prospect)
#   SES_USE_SENDING_DOMAIN_REPLY_TO=false
#   OOO_STOPS_FOLLOWUPS=false
#   Enable Outlook Automatic Replies (inside + outside org) — Teams status is NOT enough.
#   Proof until SES inbound exists: OOO appears in the rep's Outlook, not LeadSense UI.
#   Optional later: SES_INBOUND_S3_BUCKET + MX + receipt rule → /api/webhooks/ses-inbound
# ---------------------------------------------------------------------------
USE_MOCK_SES=true
# Leave empty for correct To: delivery. Do not set a Gmail override during OOO tests.
TEST_EMAIL_OVERRIDE=

# AWS S3 file storage (original uploads + verified exports).
# Keep USE_MOCK_S3=true for local/dev (stores under backend/outputs/s3_mock/).
USE_MOCK_S3=true
S3_PRESIGN_EXPIRES_SECONDS=3600
MAX_UPLOAD_FILE_BYTES=26214400

# Optional SES Configuration Set (leave blank to keep send behavior unchanged)
SES_CONFIGURATION_SET=
# When true, Reply-To = personalized SES From so OOO auto-replies hit SES inbound
SES_USE_SENDING_DOMAIN_REPLY_TO=false
# When true, From = logged-in rep's real email so Outlook OOO returns to their inbox.
# Requires that email's domain to be SES domain-verified. Default false = From on
# AWS_SES_SENDING_DOMAIN (better reputation isolation; OOO may not reach the rep).
SES_USE_REPLY_TO_AS_FROM=false
# Bucket used by SES receipt rule for raw inbound MIME (separate from file uploads)
SES_INBOUND_S3_BUCKET=
SES_INBOUND_S3_PREFIX=inbound/
# When true, out_of_office stops follow-ups; default false = detect/status only
OOO_STOPS_FOLLOWUPS=false

# Groq
GROQ_API_KEY=your-groq-api-key
USE_MOCK_GROQ=true

# Blacklist / suppression
SOFT_BOUNCE_THRESHOLD=3

# MillionVerifier — verify emails before AWS SES (blocks invalid/risky).
# Put your real API key here; keep USE_MOCK_MILLIONVERIFIER=true for local
# (mock always returns ok and does not call the API / spend credits).
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_ENABLED=true
USE_MOCK_MILLIONVERIFIER=true
MILLIONVERIFIER_TIMEOUT_SECONDS=10
MILLIONVERIFIER_CACHE_DAYS=30
# Comma-separated result values allowed to send (ok | catch_all | unknown | ...)
MILLIONVERIFIER_ALLOWED_RESULTS=ok
MILLIONVERIFIER_API_URL=https://api.millionverifier.com/api/v3/

# Passwords for the named accounts in app/services/core_users.py — JSON
# object of {email: password}. Never commit real values; this file is a
# template only. Only emails present here (and in CORE_USERS) can log in.
CORE_USER_PASSWORDS={"name@feuji.com":"change-me"}

# LinkedIn Sales Navigator extraction (Apify + Playwright session check)
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Optional: dedicated actor for /in/ profile scrape (Profile Extractor).
# When empty, APIFY_ACTOR_ID is used as fallback.
APIFY_PROFILE_ACTOR_ID=
# Bulk Excel extract: concurrent Apify batches (reuses APIFY_ACTOR_ID / APIFY_PROFILE_ACTOR_ID)
MAX_CONCURRENT_APIFY_RUNS=10
MAX_CONCURRENT_BATCHES=10
APIFY_BATCH_SIZE=10
PROCESSING_WINDOW=100
APIFY_MAX_RETRIES=3
MAX_BULK_URLS=5000
BULK_RETRY_BASE_DELAY_SECONDS=5
BULK_RETRY_BACKOFF_MULTIPLIER=2
BULK_STALE_PROCESSING_SECONDS=900
VERIFY_MATCH_THRESHOLD=100
VERIFY_REVIEW_THRESHOLD=100
# Comma-separated; matching last_error text is treated as non-retryable
BULK_NON_RETRYABLE_ERRORS=invalid url,malformed,permanently unavailable,profile not found,not a linkedin
LINKEDIN_LI_AT=
# Optional full cookie-array JSON from a "Copy Cookies" browser extension
# (server-side only; never sent by end users)
LINKEDIN_COOKIES_JSON=
# Profile extract-profile uses Playwright viewport screenshots + backend OCR
# (PaddleOCR if installed, else RapidOCR). Install: pip install rapidocr-onnxruntime paddleocr

# ---------------------------------------------------------------------------
# S3 buckets — check / switch here (only one S3_BUCKET_NAME active).
# UAT

# Prod
# S3_BUCKET_NAME=prod-s3-leadsense-bucket
